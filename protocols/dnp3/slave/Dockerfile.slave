FROM python:3.11-slim AS build

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libssl-dev \
    libasio-dev \
    && rm -rf /var/lib/apt/lists/*

COPY lib/dnp3-python /build/lib/dnp3-python
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir /build/lib/dnp3-python pyyaml

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv
COPY protocols/dnp3/slave/slave.py /app/slave.py

EXPOSE 20000

ENTRYPOINT ["python", "/app/slave.py"]
