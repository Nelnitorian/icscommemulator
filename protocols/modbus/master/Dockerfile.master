# Build stage
FROM golang:1.21-alpine AS build

WORKDIR /app

# Install git for go mod download
RUN apk add --no-cache git

# Initialize module and install dependencies
COPY main.go ./
RUN go mod init modbus-master && \
    go get github.com/goburrow/modbus@v0.1.0 && \
    go get github.com/sirupsen/logrus@v1.9.3

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o master ./main.go

# Final stage
FROM alpine:latest

# Add ca-certificates for HTTPS requests (if needed)
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy the binary from build stage
COPY --from=build /app/master ./master

# Make sure the binary is executable
RUN chmod +x ./master

# Expose port (although master typically connects outbound)
EXPOSE 502

# Run the master application
ENTRYPOINT ["./master"]
