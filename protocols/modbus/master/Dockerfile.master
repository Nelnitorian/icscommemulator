# Build stage
FROM golang:1.21-alpine AS build

WORKDIR /app

# Install git for go mod download
RUN apk add --no-cache git

# Initialize module and install dependencies
COPY main.go ./
RUN go mod init modbus-master && \
    go get github.com/goburrow/modbus@v0.1.0 && \
    go get github.com/sirupsen/logrus@v1.9.3 && \
    go get gopkg.in/yaml.v3@v3.0.1

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o master ./main.go

# Final stage (static binary)
FROM scratch

WORKDIR /app

# Copy the binary from build stage
COPY --from=build /app/master /app/master

# Run the master application
ENTRYPOINT ["/app/master"]
